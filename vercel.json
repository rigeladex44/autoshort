{
  "version": 2,
  "rewrites": [
    {
      "source": "/r/:slug",
      "destination": "/api/redirect?slug=:slug"
    },
    {
      "source": "/s/:slug",
      "destination": "/api/redirect?slug=:slug"
    },
    {
      "source": "/:slug([a-zA-Z0-9_-]{2,64})",
      "destination": "/api/redirect?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
