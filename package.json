{
  "name": "autoshort",
  "version": "2.0.0",
  "description": "Modern URL Shortener & Analytics Dashboard for Vercel (Bitly / s.id style)",
  "main": "index.html",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test --test-isolation=none test/api.test.js",
    "test:browser": "node test/browser.mjs"
  },
  "keywords": [
    "shortlink",
    "url-shortener",
    "dashboard",
    "analytics",
    "bitly-clone",
    "sid-clone",
    "vercel",
    "qr-code"
  ],
  "author": "rigeladex44",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
