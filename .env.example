# Cloud links shared across devices. Apply supabase_schema.sql first.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Required in cloud mode. Enter the same token in dashboard Settings.
ADMIN_TOKEN=
# Custom domain: configure in dashboard Settings after connecting DNS/HTTPS in Vercel.

# Existing Vercel project/team identifiers for dashboard domain management (not secrets).
AUTOSHORT_VERCEL_PROJECT_ID=
AUTOSHORT_VERCEL_TEAM_ID=
# Connect the Vercel secret token securely in dashboard Settings.
# Alternatively, set VERCEL_DOMAINS_TOKEN as a server secret; never commit its value.
