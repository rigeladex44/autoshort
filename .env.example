# Cloud links shared across devices. Apply supabase_schema.sql first.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy server maintenance token; never enter it in the dashboard.
ADMIN_TOKEN=
# Custom domain: configure in dashboard Settings after connecting DNS/HTTPS in Vercel.

# Existing Vercel project/team identifiers for dashboard domain management (not secrets).
AUTOSHORT_VERCEL_PROJECT_ID=
AUTOSHORT_VERCEL_TEAM_ID=
# Connect the Vercel secret token securely in dashboard Settings.
# Alternatively, set VERCEL_DOMAINS_TOKEN as a server secret; never commit its value.

# Supabase Auth: public anon key; used server-side with the verified user JWT.
SUPABASE_ANON_KEY=
# Existing auth.users UUID of the platform owner (not an email).
OWNER_USER_ID=
# Canonical HTTPS dashboard origin; also add its /** URL to Supabase redirects.
AUTH_SITE_URL=http://localhost:3000
# Enable after configuring the Google provider in Supabase Auth.
AUTH_GOOGLE_ENABLED=false
# Existing shared shortlink hosts, comma separated; personal domains are stored per account.
PLATFORM_HOSTS=
