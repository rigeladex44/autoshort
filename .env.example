# ==========================================================
# AUTOSHORT CONFIGURATION (ENVIRONMENT VARIABLES)
# ==========================================================
# CATATAN: AutoShort siap digunakan langsung (Zero-Config) 
# menggunakan LocalStorage di browser tanpa perlu setup database.
#
# Jika ingin data tersimpan permanen di cloud & sync antar perangkat,
# aktifkan salah satu opsi berikut di Vercel Dashboard > Project Settings > Environment Variables:

# OPSI A: SUPABASE (Direkomendasikan - Gratis & Cepat)
# Dapatkan dari: https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key (opsional)

# OPSI B: UPSTASH REDIS (Vercel KV alternative)
# Dapatkan dari: https://upstash.com -> Redis Database -> REST API
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# OPSI: DOMAIN UTAMA / CUSTOM DOMAIN
# Masukkan nama domain utama Anda jika sudah dihubungkan di Vercel:
CUSTOM_DOMAIN=rigeel.id
